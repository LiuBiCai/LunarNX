 uint32_t ports_get_epoch_time() {
+#ifdef _WIN32
+  return (uint32_t)GetTickCount64();
+#else
   struct timeval tv;
   gettimeofday(&tv, NULL);
   return (uint32_t)tv.tv_sec * 1000 + tv.tv_usec / 1000;
+#endif
+}
+
+uint64_t ports_get_monotonic_us() {
+#ifdef _WIN32
+  LARGE_INTEGER frequency;
+  LARGE_INTEGER counter;
+  if (!QueryPerformanceFrequency(&frequency) ||
+      !QueryPerformanceCounter(&counter) || frequency.QuadPart <= 0) {
+    return (uint64_t)GetTickCount64() * 1000u;
+  }
+  return (uint64_t)((counter.QuadPart * 1000000ULL) / frequency.QuadPart);
+#else
+  struct timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
+    return (uint64_t)now.tv_sec * 1000000u +
+           (uint64_t)now.tv_nsec / 1000u;
+  }
+  return (uint64_t)ports_get_epoch_time() * 1000u;
+#endif
 }
 
 void ports_sleep_ms(int ms) {
 #if CONFIG_USE_LWIP
   sys_msleep(ms);
+#elif defined(_WIN32)
+  Sleep(ms > 0 ? (DWORD)ms : 0);
 #else
   usleep(ms * 1000);
 #endif
