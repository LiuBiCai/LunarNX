new file mode 100644
index 0000000..624252e
--- /dev/null
+++ b/src/socket_compat.h
@@ -0,0 +1,181 @@
+#ifndef SOCKET_COMPAT_H_
+#define SOCKET_COMPAT_H_
+
+#include <stdint.h>
+
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <errno.h>
+
+typedef int socklen_t;
+typedef SOCKET PeerSocket;
+
+#define PEER_INVALID_SOCKET INVALID_SOCKET
+#define PEER_SOCKET_VALID(socket_fd) ((socket_fd) != INVALID_SOCKET)
+#define PEER_SELECT_NFDS(max_socket) 0
+#define PEER_NONBLOCKING_RECV_FLAG 0
+
+static inline int peer_socket_close(PeerSocket socket_fd) {
+  return closesocket(socket_fd);
+}
+
+static inline int peer_socket_set_nonblocking(PeerSocket socket_fd) {
+  u_long enabled = 1;
+  return ioctlsocket(socket_fd, FIONBIO, &enabled);
+}
+
+static inline void peer_socket_capture_error(void) {
+  const int error = WSAGetLastError();
+  switch (error) {
+    case WSAEWOULDBLOCK:
+      errno = EWOULDBLOCK;
+      break;
+    case WSAEINTR:
+      errno = EINTR;
+      break;
+    case WSAENOBUFS:
+      errno = ENOBUFS;
+      break;
+    case WSAEBADF:
+      errno = EBADF;
+      break;
+    case WSAEACCES:
+      errno = EACCES;
+      break;
+    case WSAEADDRINUSE:
+      errno = EADDRINUSE;
+      break;
+    case WSAEADDRNOTAVAIL:
+      errno = EADDRNOTAVAIL;
+      break;
+    case WSAENETUNREACH:
+      errno = ENETUNREACH;
+      break;
+    case WSAECONNRESET:
+      errno = ECONNRESET;
+      break;
+    case WSAECONNREFUSED:
+      errno = ECONNREFUSED;
+      break;
+    case WSAETIMEDOUT:
+      errno = ETIMEDOUT;
+      break;
+    default:
+      errno = EIO;
+      break;
+  }
+}
+
+static inline int peer_setsockopt(PeerSocket socket_fd,
+                                  int level,
+                                  int option,
+                                  const void* value,
+                                  socklen_t value_length) {
+  return setsockopt(socket_fd, level, option, (const char*)value,
+                    value_length);
+}
+
+static inline int peer_getsockopt(PeerSocket socket_fd,
+                                  int level,
+                                  int option,
+                                  void* value,
+                                  socklen_t* value_length) {
+  return getsockopt(socket_fd, level, option, (char*)value, value_length);
+}
+
+static inline int peer_bind(PeerSocket socket_fd,
+                            const struct sockaddr* address,
+                            socklen_t address_length) {
+  return bind(socket_fd, address, address_length);
+}
+
+static inline int peer_getsockname(PeerSocket socket_fd,
+                                   struct sockaddr* address,
+                                   socklen_t* address_length) {
+  return getsockname(socket_fd, address, address_length);
+}
+
+static inline int peer_connect(PeerSocket socket_fd,
+                               const struct sockaddr* address,
+                               socklen_t address_length) {
+  return connect(socket_fd, address, address_length);
+}
+
+static inline int peer_sendto(PeerSocket socket_fd,
+                              const uint8_t* buffer,
+                              int length,
+                              int flags,
+                              const struct sockaddr* address,
+                              socklen_t address_length) {
+  return sendto(socket_fd, (const char*)buffer, length, flags,
+                address, address_length);
+}
+
+static inline int peer_recvfrom(PeerSocket socket_fd,
+                                uint8_t* buffer,
+                                int length,
+                                int flags,
+                                struct sockaddr* address,
+                                socklen_t* address_length) {
+  return recvfrom(socket_fd, (char*)buffer, length, flags,
+                  address, address_length);
+}
+
+static inline int peer_send(PeerSocket socket_fd,
+                            const uint8_t* buffer,
+                            int length,
+                            int flags) {
+  return send(socket_fd, (const char*)buffer, length, flags);
+}
+
+static inline int peer_recv(PeerSocket socket_fd,
+                            uint8_t* buffer,
+                            int length,
+                            int flags) {
+  return recv(socket_fd, (char*)buffer, length, flags);
+}
+
+#else
+
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <sys/select.h>
+#include <unistd.h>
+
+typedef int PeerSocket;
+
+#define PEER_INVALID_SOCKET (-1)
+#define PEER_SOCKET_VALID(socket_fd) ((socket_fd) >= 0)
+#define PEER_SELECT_NFDS(max_socket) ((max_socket) + 1)
+#define PEER_NONBLOCKING_RECV_FLAG MSG_DONTWAIT
+
+static inline int peer_socket_close(PeerSocket socket_fd) {
+  return close(socket_fd);
+}
+
+static inline int peer_socket_set_nonblocking(PeerSocket socket_fd) {
+  (void)socket_fd;
+  return 0;
+}
+
+#define peer_socket_capture_error() ((void)0)
+#define peer_setsockopt setsockopt
+#define peer_getsockopt getsockopt
+#define peer_bind bind
+#define peer_getsockname getsockname
+#define peer_connect connect
+#define peer_sendto sendto
+#define peer_recvfrom recvfrom
+#define peer_send send
+#define peer_recv recv
+
+#endif
+
+#endif
